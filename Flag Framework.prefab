--- !u!114 &6726400015927089120
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1450327976445928608}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec3b8824308adc64fb1901cef109132a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mutators:
  - name: Custom Flags Framework
    description: A framework that is used to replace vanilla flag designs with your
      own!
    menuImage: {fileID: 2800000, guid: d3c14ea8963856f4da6a3b57ef709510, type: 3}
    mutatorPrefab: {fileID: 1450327976445928608}
    configuration:
      labels:
      - id: 
        displayName: <b><color=lightblue>The framework will wait this amount of time
          for other packs to load per added pack. Increase this if packs are not
          being added in time.</color></b>
        orderPriority: 7
      - id: 
        displayName: <color=lightblue>Type in your configurations in the inputs below!
          Preferably you should use the "Flag Viewer" map to create your output,
          however if you want, you can also type manually.</color>
        orderPriority: 0
      - id: 
        displayName: <b><color=lightblue>This will try to apply flag textures to
          every flag like material that the framework can. If you have issues with
          textures that are flag-like, try disabling the below options.</color></b>
        orderPriority: 13
      - id: 
        displayName: <color=yellow>This determines how likely it is for an actor
          to spawn with the same flag as the last actors. This is rolled BEFORE the
          point chance.</color>
        orderPriority: 20
      - id: 
        displayName: <color=orange>This determines how likely it is for an actor
          to get their flag from the capture point they spawned at. If this fails,
          the actor will get a random flag which then creates a group that later
          actors can spawn as.</color>
        orderPriority: 22
      - id: 
        displayName: <b><color=lightblue>The below are values that are misc/can be
          ignored</color></b>
        orderPriority: 30
      - id: 
        displayName: 
        orderPriority: 6
      - id: 
        displayName: 
        orderPriority: 19
      - id: 
        displayName: 
        orderPriority: 25
      - id: 
        displayName: 
        orderPriority: 9
      - id: 
        displayName: Aggressively search for the word "FLAG" in each material for
          replacement. This can cause unexpected issues! Use only when necessary!
        orderPriority: 15
      integers:
      - id: WaitForMutators
        displayName: Wait Time (seconds)
        orderPriority: 8
        value: 3
      floats: []
      ranges:
      - id: ChanceInGroup
        displayName: <color=yellow>Actor Spawning With Group Flag (%)</color>
        orderPriority: 21
        value:
          value: 80
          min: 0
          max: 100
          wholeNumbers: 1
      - id: ChanceFromPoint
        displayName: <color=orange>Actor Spawning With Point (%)</color>
        orderPriority: 23
        value:
          value: 50
          min: 0
          max: 100
          wholeNumbers: 0
      strings:
      - id: BlueFlagTextures
        displayName: <color=blue>Eagle Flag(s)</color>
        orderPriority: 1
        value: 
      - id: RedFlagTextures
        displayName: <color=red>Raven Flag(s)</color>
        orderPriority: 2
        value: 
      - id: ExtraFlagTextures
        displayName: <color=orange>Other Team Flag(s)</color>
        orderPriority: 2
        value: 
      - id: Meshes
        displayName: <color=green>Accessories</color>
        orderPriority: 3
        value: 
      - id: Voices
        displayName: <color=purple>Team Voices</color>
        orderPriority: 3
        value: 
      bools:
      - id: ChangeTeamNamesToFlagName
        displayName: Change Team Names to Flag Names
        orderPriority: 5
        value: 0
      - id: ChangeTeamColorToFlagColor
        displayName: Change Team Color from Flag
        orderPriority: 5
        value: 0
      - id: IgnoreFailedCapturePoint
        displayName: Ignore Non-Changeable Capture Points
        orderPriority: 50
        value: 0
      - id: AvoidDupeColors
        displayName: Auto Change Dupe Team Colors
        orderPriority: 49
        value: 1
      - id: FunnyMode
        displayName: funny mode (dont enable this seriously you will kill your eyes)
        orderPriority: 50
        value: 0
      - id: AvoidDupeData
        displayName: Auto Rename Dupe Data
        orderPriority: 49
        value: 1
      - id: ChangeScoreboardToTeamFlag
        displayName: Change Scoreboard BG to Flag
        orderPriority: 5
        value: 0
      - id: ApplyTextureToVehicles
        displayName: Apply Flag Textures to Vehicles
        orderPriority: 14
        value: 1
      - id: ApplyTextureToWeapons
        displayName: Apply Flag Textures to Weapons
        orderPriority: 14
        value: 1
      - id: AggressiveFlagSearch
        displayName: Aggressive Flag Search
        orderPriority: 16
        value: 0
      - id: SetActorColorToFlagColor
        displayName: Change Individual Actor Color From Flag (REQUIRES LOVE BITES)
        orderPriority: 5
        value: 0
      - id: DebugMode
        displayName: Debug Mode
        orderPriority: 50
        value: 0
      dropdowns:
      - id: ExecuteConfigForTeam
        displayName: What Team's Config to Execute First
        orderPriority: 4
        value:
          index: 0
          labels:
          - <color=blue>EAGLE</color>
          - <color=red>RAVEN</color>
          - <color=#fc0fc0>RANDOMIZE</color>
