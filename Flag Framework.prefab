--- !u!114 &6726400015927089120
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1450327976445928608}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec3b8824308adc64fb1901cef109132a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mutators:
  - name: Custom Flags Framework
    description: A framework that is used to replace vanilla flag designs with your
      own!
    menuImage: {fileID: 2800000, guid: d3c14ea8963856f4da6a3b57ef709510, type: 3}
    mutatorPrefab: {fileID: 1450327976445928608}
    configuration:
      labels:
      - id: 
        displayName: The framework will wait this amount of time between each added
          texture to account for mutators loading after the framework. Increase this
          slightly if log is ranting about textures being added after the registration
          period.
        orderPriority: 4
      - id: 
        displayName: Paste or type in your configurations in the inputs below! Preferably
          you should use the "Flag Viewer" map to create your output, however if
          you want, you can also type manually.
        orderPriority: 0
      integers:
      - id: WaitForMutators
        displayName: Wait Time for Flag Mutators (seconds)
        orderPriority: 5
        value: 3
      floats: []
      ranges: []
      strings:
      - id: BlueFlagTextures
        displayName: <color=blue>Eagle Flag(s)</color>
        orderPriority: 1
        value: 
      - id: RedFlagTextures
        displayName: <color=red>Raven Flag(s)</color>
        orderPriority: 1
        value: 
      - id: Meshes
        displayName: <color=green>Accessories</color>
        orderPriority: 2
        value: 
      bools:
      - id: ChangeTeamNamesToFlagName
        displayName: Change Team Names to Flag Names
        orderPriority: 4
        value: 0
      - id: ChangeTeamColorToFlagColor
        displayName: Change Team Color from Flag
        orderPriority: 4
        value: 0
      - id: IgnoreFailedCapturePoint
        displayName: Ignore Non-Changeable Capture Points
        orderPriority: 6
        value: 0
      - id: AvoidDupeColors
        displayName: Auto Change Dupe Team Colors
        orderPriority: 7
        value: 1
      - id: FunnyMode
        displayName: funny mode (dont enable this seriously you will kill your eyes)
        orderPriority: 11
        value: 0
      - id: AvoidDupeData
        displayName: Auto Rename Dupe Data
        orderPriority: 10
        value: 1
      - id: ChangeScoreboardToTeamFlag
        displayName: Change Scoreboard BG to Flag
        orderPriority: 4
        value: 1
      - id: AlwaysRandomizeActorFlag
        displayName: Always Randomize Assigned Flag for Actor
        orderPriority: 12
        value: 0
      dropdowns:
      - id: ExecuteConfigForTeam
        displayName: What Team's Config to Execute First
        orderPriority: 2
        value:
          index: 0
          labels:
          - <color=blue>EAGLE</color>
          - <color=red>RAVEN</color>
          - <color=#fc0fc0>RANDOMIZE</color>
