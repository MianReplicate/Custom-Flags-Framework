--- !u!114 &1726073807400080023
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1450327976445928608}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25180ebf807ab1247b56be71f8977fe6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  repeatType: 0
  lines:
  - actorPose: p advisor
    overrideName: Mian
    text: Heads up <color=#66ff00><player></color>! Just wanted to let you know from
      the <color=#fc0fc0>Custom Flags Framework</color> that some of the flags within
      <color=#0096FF><map></color> are <color=red>unable</color> to be changed.
    portraitGrain: 0
    onSayLine:
      destinations: []
    blipSoundPlayback: 0
    overrideBlipSound: 0
    overrideBlipCustomClip: {fileID: 0}
    duration: 11
  onDialogComplete:
    destinations: []
  stopActiveDialogOnComponentDisabled: 1
